+// https://github.com/Lakonik/ComfyUI-piFlow/blob/main/piflow_scheduler.py
+// Builds a uniform raw_t schedule from max_raw_t down to
+//   (max_raw_t - min_raw_t) * final_step_size_scale / (n - 1 + final_step_size_scale) + min_raw_t
+// and maps each raw_t through the denoiser's own time-shift curve (e.g. shift=12 for MiniMax-H3).
+struct PiFlowScheduler : SigmaScheduler {
+    float min_raw_t             = 0.0f;
+    float max_raw_t             = 1.0f;
+    float final_step_size_scale = 1.0f;
+
+    explicit PiFlowScheduler(const char* extra_sample_args = nullptr) {
+        parse_extra_sample_args(extra_sample_args);
+    }
+
+    void parse_extra_sample_args(const char* extra_sample_args) {
+        for (const auto& [key, value] : parse_key_value_args(extra_sample_args, "piflow scheduler arg")) {
+            if (key == "min_raw_t") {
+                if (!parse_strict_float(value, min_raw_t)) {
+                    LOG_WARN("ignoring invalid piflow scheduler arg '%s=%s'", key.c_str(), value.c_str());
+                }
+            } else if (key == "max_raw_t") {
+                if (!parse_strict_float(value, max_raw_t)) {
+                    LOG_WARN("ignoring invalid piflow scheduler arg '%s=%s'", key.c_str(), value.c_str());
+                }
+            } else if (key == "final_step_size_scale") {
+                if (!parse_strict_float(value, final_step_size_scale)) {
+                    LOG_WARN("ignoring invalid piflow scheduler arg '%s=%s'", key.c_str(), value.c_str());
