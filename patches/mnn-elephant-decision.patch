+class LinearAttentionTiledHeadTest : public MNNTestCase {
+public:
+    virtual bool run(int precision) override {
+        const int B = 1, K = 2, V = 4, dk = 4, dv = 4, D = 2 * K * dk + V * dv;
+        auto module = _makeLinearAttentionModule(K, V, dk, dv, true, "gated_delta_rule_tiled");
+        if (!module) {
+            return false;
+        }
+        NaiveLinearAttention naive;
+        naive.init(B, D, 4, V, dk, dv);
+        auto convW = _Input({D, 1, 4}, NCHW, halide_type_of<float>());
+        fillConvWeight(convW->writeMap<float>(), D * 4);
+        int step = 0;
+        for (int L : {4, 1, 1}) {
+            auto qkv = _Input({B, D, L}, NCHW, halide_type_of<float>());
+            auto gate = _Input({B, L, V}, NCHW, halide_type_of<float>());
+            auto beta = _Input({B, L, V}, NCHW, halide_type_of<float>());
+            fillDeterministic(qkv->writeMap<float>(), B * D * L, 0.1f, 0.01f * step);
+            fillGate(gate->writeMap<float>(), B * L * V);
+            fillBeta(beta->writeMap<float>(), B * L * V);
+            auto expected = naive.forward(qkv->readMap<float>(), gate->readMap<float>(), beta->readMap<float>(),
+                                          convW->readMap<float>(), B, L, D, 4, K, V, dk, dv, true, true);
+            auto outputs = module->onForward({qkv, gate, beta, convW});
+            if (outputs.empty() || outputs[0] == nullptr) {
+                return false;
+            }
+            const float* actual = outputs[0]->readMap<float>();
+            for (int index = 0; index < B * L * V * dv; ++index) {
+                if (std::fabs(actual[index] - expected[index]) > 0.01f) {
+                    MNN_ERROR("Tiled GDN failed at step %d index %d: %f vs %f\n",
+                              step, index, actual[index], expected[index]);
+                    return false;
+                }
+            }
+            ++step;
+        }
+        return true;
+    }
+};
+MNNTestSuiteRegister(LinearAttentionTiledHeadTest, "op/linear_attention_tiled_heads");
 MNNTestSuiteRegister(LinearAttentionGateFoldTest, "op/linear_attention_gate_fold");
 
